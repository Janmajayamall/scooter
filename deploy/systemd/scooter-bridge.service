# Scooter's bridge, as root (8.5 of DESIGN.md). `sudo scooter setup` installs and enables this
# unit, and doesn't start it: fill in /etc/scooter/bridge.env first.
#
# - It runs as root, and starts wacli and the email reader as their own users.
# - `scooter` is a wrapper that `exec`s Node, so Node is the main process: `systemctl kill
#   --kill-whom=main -s USR1 scooter-bridge` starts a backup, and reaches the bridge alone.
# - Stopping it stops every process of the unit, wacli and the email reader among them.
# - It restarts on failure, after waits that grow from 5 seconds to 5 minutes, as the bridge's own
#   restarts of wacli and the email reader do (RESTART_BACKOFF). systemd keeps counting the
#   restarts until the unit is started by hand or the machine starts again (D207).

[Unit]
Description=Scooter bridge: WhatsApp, email, delivery and backups
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/scooter bridge
Environment=TZ=UTC
KillMode=control-group
Restart=on-failure
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target

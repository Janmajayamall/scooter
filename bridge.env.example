# Scooter: the bridge's settings.
#
# Natively, `scooter setup` copies this file to /etc/scooter/bridge.env (root, mode 0600).
# In Docker, copy it to bridge.env beside compose.yaml.
# Only the bridge reads it. The runner has its own file, runner.env, and neither service sees
# the other's secrets.
#
# Format: one KEY=value per line, and comments on lines of their own.
# - No spaces around the "=", and no "export".
# - A value with $, \, # or a double quote in it must be inside single quotes: KEY='pa$$word'
#   Nothing is expanded, inside quotes or outside.
# - A value can't contain a single quote, and can't run over several lines.
# - A variable that's empty or left out takes its default.
# - A variable already set in the service's environment wins over this file.

# --- WhatsApp ---

# The owner's WhatsApp number, in international format. Required.
# Scooter accepts messages from this number and from nobody else.
OWNER_NUMBER=

# Other WhatsApp IDs that are the owner, separated by commas. WhatsApp sometimes delivers
# messages from an ID such as 123456789012345@lid in place of the number. If the bridge logs
# that it dropped a message from an ID that is yours, add the ID here.
# OWNER_JIDS=

# Where Scooter sends what it says on its own, such as notices and scheduled tasks, and its
# replies about emails. Only whatsapp can send, so only whatsapp is allowed: the bridge refuses
# to start with anything else.
# DEFAULT_CHANNEL=whatsapp

# --- Email (optional) ---

# The IMAP server of Scooter's own mailbox, such as imap.gmail.com. Empty turns email off.
# Use an address that only Scooter uses, never your own mailbox.
# EMAIL_IMAP_HOST=

# The port for IMAP over TLS.
# EMAIL_IMAP_PORT=993

# The mailbox's address, and an app password for it. Required when email is on.
# EMAIL_USER=
# EMAIL_PASSWORD=

# Your own email addresses, separated by commas. Required when email is on.
# Mail from any other address is skipped, and so is mail from these that doesn't pass DMARC: your
# address's domain must publish a DMARC record. `scooter email-check` shows whether it passes.
# EMAIL_OWNER_ADDRESSES=

# The server name the mailbox's provider writes in the Authentication-Results header of the mail
# it receives, such as mx.google.com. The bridge doesn't start with email on and without it. To
# find it, set the settings above, send an email to the mailbox from your own address, and run
# `scooter email-check`, which works before this is set: it shows the server named on top of each
# message, and whether each would be kept.
# EMAIL_AUTHSERV_ID=

# The longest the email reader goes between checks of the mailbox, in seconds (10 to 3600).
# EMAIL_CHECK_SECONDS=60

# --- Time ---

# Your IANA time zone. It is used only for what you see or set: replies, /status and BACKUP_TIME.
# Everything Scooter stores is in UTC. Keep it the same as in runner.env.
# SCOOTER_TZ=Asia/Kolkata

# --- Backups (optional) ---

# When the nightly backup runs: HH:MM in SCOOTER_TZ, or off.
# BACKUP_TIME=03:30

# The restic repository, and the password that encrypts it. Without a repository, backups are
# off. Keep the password in a password manager too: this file isn't backed up, and without the
# password a backup can't be read.
#   Cloudflare R2: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/scooter
#   Backblaze B2:  b2:<bucket>:scooter
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=

# The bucket's credentials. For R2:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# For B2:
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# How many daily, weekly and monthly backups are kept.
# RESTIC_KEEP_DAILY=7
# RESTIC_KEEP_WEEKLY=4
# RESTIC_KEEP_MONTHLY=12

# --- Folders ---

# Where the data and the configuration are. Natively, `scooter setup` fills these in. In Docker
# they are /data and /config, the defaults.
# DATA_DIR=/data
# CONFIG_DIR=/config

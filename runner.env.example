# Scooter: the runner's settings.
#
# Natively, `scooter setup` copies this file to /etc/scooter/runner.env (owned by scooter-runner,
# mode 0600). In Docker, copy it to runner.env beside compose.yaml.
# Only the runner reads it. The bridge has its own file, bridge.env, and neither service sees
# the other's secrets.
#
# Format: one KEY=value per line, and comments on lines of their own.
# - No spaces around the "=", and no "export".
# - A value with $, \, # or a double quote in it must be inside single quotes: KEY='pa$$word'
#   Nothing is expanded, inside quotes or outside.
# - A value can't contain a single quote, and can't run over several lines.
# - A variable that's empty or left out takes its default.
# - A variable already set in the service's environment wins over this file.

# --- OpenRouter ---

# Scooter's own OpenRouter key. Required. The runner puts it on the agent's requests to
# OpenRouter as they leave; the agent itself only ever sees a placeholder. Give the key a
# guardrail on OpenRouter that enforces zero data retention for every model group, excluding
# Safety Retention ("ZDR only"), allows only the agent's model and caps spending, and keep the
# account's own prompt logging off.
OPENROUTER_API_KEY=

# on sends every request only to endpoints that keep no prompts or responses. off leaves that
# to the settings of the key and the account.
# OPENROUTER_ZDR=on

# --- The agent ---

# on lets the agent reach public HTTPS websites, through the runner, which logs every request.
# off, the default, lets it reach OpenRouter and nothing else. Either way, plain HTTP, private
# addresses and OpenRouter's other hosts are refused, and every request, and every refusal, is in
# the network log, runner/log/<UTC date>.jsonl in the data folder.
# AGENT_INTERNET=off

# How the agent's virtual machines run: auto, kvm or emulation. auto uses KVM when the runner can
# open /dev/kvm, and falls back to emulation, which is about ten times slower; it tells you once
# when it falls back. kvm or emulation forces one, and the runner stops if it can't be used. hvf
# is for macOS, later.
# AGENT_ACCEL=auto

# How many seconds you must be quiet before the agent starts on your messages (1 to 600).
# BATCH_SECONDS=8

# The hour of your day, 0 to 23, at which the agent starts a fresh conversation.
# SESSION_ROLLOVER_HOUR=4

# The currency of an amount that names none: an ISO code of three capital letters.
# HOME_CURRENCY=INR

# --- Time ---

# Your IANA time zone. It is used only for what you see or set: the times the agent is shown and
# writes, and the times of scheduled tasks. Everything Scooter stores is in UTC. Keep it the same
# as in bridge.env. Write it as the tz database does: the runner won't start with a zone the
# agent's VM image doesn't know, such as Asia/KOLKATA.
# SCOOTER_TZ=Asia/Kolkata

# --- Folders ---

# Where the data and the configuration are. Natively, `scooter setup` fills these in. In Docker
# they are /data and /config, the defaults. `scooter build-image` reads these two, and nothing
# else of this file, to know where the build file is and where the image goes.
# DATA_DIR=/data
# CONFIG_DIR=/config
